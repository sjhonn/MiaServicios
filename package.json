{
  "name": "miaservicios-platform",
  "version": "3.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/api-gateway",
    "backend/auth-service",
    "backend/ai-service",
    "backend/history-service"
  ],
  "scripts": {
    "dev": "node backend/tools/run-processes.mjs dev all",
    "dev:frontend": "npm run dev --workspace=@miaservicios/frontend",
    "dev:backend": "node backend/tools/run-processes.mjs dev backend",
    "build": "npm run build --workspace=@miaservicios/frontend",
    "build:pages": "npm run build",
    "preview": "npm run preview --workspace=@miaservicios/frontend",
    "serve:docs": "node backend/tools/serve-docs.mjs",
    "start": "node backend/tools/run-processes.mjs start backend",
    "start:local": "node backend/tools/run-processes.mjs start local",
    "check": "npm run check:structure && npm run check --workspaces --if-present && node --check backend/tools/run-processes.mjs && node --check backend/tools/serve-docs.mjs && node --check backend/tools/create-env.mjs",
    "test": "node backend/tests/nlp-smoke.mjs && node backend/tests/session-smoke.mjs",
    "validate": "npm run check && npm test && npm run build",
    "docker:config": "docker compose --env-file .env config",
    "docker:up": "docker compose --env-file .env up --build -d",
    "docker:down": "docker compose --env-file .env down",
    "docker:status": "docker compose --env-file .env ps",
    "env:init": "node backend/tools/create-env.mjs",
    "check:structure": "node backend/tools/validate-structure.mjs"
  },
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.0.0"
  }
}
